# Скопируйте этот файл в .env и заполните своими значениями.

# Токен бота, который выдаёт @BotFather
BOT_TOKEN=

# Кто получает заявки и видит админ-панель. Несколько ID — через запятую.
# Свой ID можно узнать у бота @userinfobot
ADMIN_IDS=

# Файл базы данных
DB_PATH=bot.db

# Прокси для доступа к Telegram API. Нужен только если api.telegram.org
# недоступен напрямую (в России он блокируется). Примеры:
#   PROXY_URL=socks5://127.0.0.1:1080
#   PROXY_URL=http://127.0.0.1:8080
PROXY_URL=